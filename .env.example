# Copy to .env and export, or set in your shell. Never commit real values.
HF_TOKEN=            # gated models / datasets on the Hugging Face Hub
WANDB_API_KEY=       # optional: experiment tracking (pip install polyglotlm[tracking])
TEACHER_API_KEY=     # teacher model for distillation (pip install polyglotlm[teacher])
DATA_BUCKET=         # optional: root directory for corpus snapshots (local or mounted path)
